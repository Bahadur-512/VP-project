@page "/forgot-password"
@layout AuthLayout
@attribute [AllowAnonymous]


<div class="auth-layout">
    <div class="auth-brand">
        <div class="auth-float"></div>
        <div class="auth-float"></div>
        <div class="auth-float"></div>
        <div class="auth-float"></div>

        <div class="auth-brand-icon"><i class="bi bi-building"></i></div>
        <div class="auth-brand-name">Civic Pulse</div>
        <div class="auth-brand-tagline">Your Voice. Your City.</div>
        <div class="auth-brand-urdu">آپ کی آواز۔ آپ کا شہر۔</div>

        <svg class="auth-svg" width="200" height="120" viewBox="0 0 200 120">
            <rect x="10" y="60" width="30" height="50" fill="white" rx="2"/>
            <rect x="50" y="40" width="30" height="70" fill="white" rx="2"/>
            <rect x="90" y="30" width="30" height="80" fill="white" rx="2"/>
            <rect x="130" y="50" width="30" height="60" fill="white" rx="2"/>
            <circle cx="25" cy="55" r="8" fill="white"/>
            <circle cx="65" cy="35" r="8" fill="white"/>
            <circle cx="105" cy="25" r="8" fill="white"/>
        </svg>

        <div class="auth-features">
            <div class="auth-feature-pill"><i class="bi bi-shield-check"></i> Report Issues Instantly</div>
            <div class="auth-feature-pill"><i class="bi bi-graph-up-arrow"></i> Real-Time Tracking</div>
            <div class="auth-feature-pill"><i class="bi bi-clock-history"></i> SLA-Based Resolution</div>
        </div>

        <div class="auth-brand-footer">BSCS 4C — Air University</div>
    </div>

    <div class="auth-panel">
        <div class="auth-wrap">
            <div class="auth-title">Forgot Password</div>
            <div class="auth-subtitle">Enter your email address and we'll send you a link to reset your password.</div>

            @if (!string.IsNullOrEmpty(Message))
            {
                <div class="auth-alert auth-alert-success"><i class="bi bi-check-circle-fill"></i> @Message</div>
            }

            @if (!string.IsNullOrEmpty(Error))
            {
                <div class="auth-alert auth-alert-danger"><i class="bi bi-exclamation-triangle-fill"></i> @Error</div>
            }

            <div class="auth-form-group">
                <label class="auth-label" for="fpEmail">Email Address</label>
                <div class="auth-input-wrapper">
                    <i class="bi bi-envelope auth-input-icon"></i>
                    <input id="fpEmail" type="email" placeholder="you@example.com" required autocomplete="email" @bind="Email" />
                </div>
            </div>

            <button type="submit" class="auth-btn auth-btn-primary auth-btn-block" @onclick="HandleSendResetLink">
                <span class="auth-btn-text">Send Reset Link</span>
            </button>

            <div class="auth-demo">
                <a href="/login" style="font-size:13px;font-weight:600;color:var(--cp-accent)"><i class="bi bi-arrow-left"></i> Back to Sign In</a>
            </div>
        </div>
    </div>
</div>

@code {
    private string Email = "";
    private string Message = "";
    private string Error = "";

    private async Task HandleSendResetLink()
    {
        Error = "";
        Message = "";

        if (string.IsNullOrWhiteSpace(Email))
        {
            Error = "Please enter your email address.";
            return;
        }

        Message = "If this email is registered, you will receive a password reset link shortly.";
    }

}
