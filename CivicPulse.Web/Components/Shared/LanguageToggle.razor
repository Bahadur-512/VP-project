@inject IJSRuntime JS
@inject IUserService UserService

<div class="cp-language-toggle" style="display:flex;gap:4px;align-items:center;">
    <button class="cp-btn cp-btn-sm @(CurrentLang == "en" ? "cp-btn-primary" : "cp-btn-secondary")"
            @onclick="SetEnglish">
        English
    </button>
    <button class="cp-btn cp-btn-sm @(CurrentLang == "ur" ? "cp-btn-primary" : "cp-btn-secondary")"
            @onclick="SetUrdu">
        اردو
    </button>
</div>

@code {
    [Parameter] public string CurrentLang { get; set; } = "en";
    [Parameter] public int? UserId { get; set; }
    [Parameter] public EventCallback<string> OnLanguageChanged { get; set; }

    private async Task SetEnglish() => await SetLanguage("en");
    private async Task SetUrdu() => await SetLanguage("ur");

    private async Task SetLanguage(string lang)
    {
        CurrentLang = lang;
        await JS.InvokeVoidAsync("CivicInterop.setHtmlLang", lang);
        await JS.InvokeVoidAsync("CivicInterop.setLocalStorage", "preferredLang", lang);

        if (UserId.HasValue)
        {
            try { await UserService.UpdateLanguageAsync(UserId.Value, lang); } catch { }
        }

        await OnLanguageChanged.InvokeAsync(lang);
    }
}
