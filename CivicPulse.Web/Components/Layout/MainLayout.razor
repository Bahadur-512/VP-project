@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject LocalizationService Loc
@inject AuthenticationStateProvider AuthStateProvider
@inject IUserService UserService

<div class="cp-layout" lang="@CurrentLang">
    <aside class="cp-sidebar @(SidebarOpen ? "open" : "")">
        <div class="cp-brand">
            <div class="cp-brand-icon"><i class="bi bi-building"></i></div>
            <div>
                <div class="cp-brand-text">Civic Pulse</div>
                <div class="cp-brand-sub">BSCS 4C - Air University</div>
            </div>
        </div>
        <NavMenu IsAuthenticated="@IsAuthenticated" IsAdmin="@IsAdmin" Language="@CurrentLang" />
        <div class="cp-sidebar-footer">
            <div>@Loc.Get("version", CurrentLang)</div>
        </div>
    </aside>

    <div class="cp-main">
        <header class="cp-topbar">
            <div class="cp-topbar-left">
                <button class="cp-sidebar-toggle" @onclick="ToggleSidebar">☰</button>
                <span class="cp-topbar-title">@Loc.Get("app.name", CurrentLang)</span>
            </div>
            <div class="cp-topbar-right">
                @if (IsAuthenticated)
                {
                    <NotificationBell UserId="@UserId" />
                }
                <LanguageToggle CurrentLang="@CurrentLang" UserId="@(IsAuthenticated ? UserId : null)"
                                OnLanguageChanged="HandleLanguageChanged" />
                @if (IsAuthenticated)
                {
                    <div class="cp-flex cp-flex-center cp-gap-sm">
                        <span style="font-size:13px;">@FullName</span>
                        <button class="cp-btn cp-btn-ghost cp-btn-sm" @onclick="Logout">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </div>
                }
            </div>
        </header>

        <main class="cp-content cp-fade-in">
            @Body
        </main>
    </div>
</div>

<div class="cp-sidebar-overlay @(SidebarOpen ? "open" : "")" @onclick="ToggleSidebar"></div>

@code {
    private bool SidebarOpen;
    private bool IsAuthenticated;
    private bool IsAdmin;
    private string CurrentLang = "en";
    private string FullName = "";
    private int UserId;

    protected override async Task OnInitializedAsync()
    {
        await Loc.InitializeAsync();
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        IsAuthenticated = user.Identity?.IsAuthenticated ?? false;

        if (IsAuthenticated)
        {
            IsAdmin = user.HasClaim("role", "Admin") || user.HasClaim("role", "SuperAdmin");
            FullName = user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "";
            var userIdClaim = user.FindFirst("userId")?.Value;
            UserId = userIdClaim != null ? int.Parse(userIdClaim) : 0;
            var langClaim = user.FindFirst("language")?.Value;
            CurrentLang = langClaim ?? "en";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var storedLang = await JS.InvokeAsync<string>("CivicInterop.getLocalStorage", "preferredLang");
            if (!string.IsNullOrEmpty(storedLang))
                CurrentLang = storedLang;
        }
        catch { }
        await JS.InvokeVoidAsync("CivicInterop.setHtmlLang", CurrentLang);
        StateHasChanged();
    }

    private void ToggleSidebar() => SidebarOpen = !SidebarOpen;

    private async Task HandleLanguageChanged(string lang)
    {
        CurrentLang = lang;
        await JS.InvokeVoidAsync("CivicInterop.setHtmlLang", lang);
    }

    private void Logout()
    {
        Navigation.NavigateTo("/api/auth/logout", true);
    }
}