@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject IUserService UserService

<div class="cp-layout" lang="en">
    <aside class="cp-sidebar @(SidebarOpen ? "open" : "")">
        <div class="cp-brand">
            <div class="cp-brand-icon"><i class="bi bi-building"></i></div>
            <div>
                <div class="cp-brand-text">Civic Pulse</div>
                <div class="cp-brand-sub">BSCS 4C - Air University</div>
            </div>
        </div>
        <NavMenu IsAuthenticated="@IsAuthenticated" IsAdmin="@IsAdmin" />
        <div class="cp-sidebar-footer">
            <div>v1.0.0</div>
        </div>
    </aside>

    <div class="cp-main">
        <header class="cp-topbar">
            <div class="cp-topbar-left">
                <button class="cp-sidebar-toggle" @onclick="ToggleSidebar">☰</button>
                <span class="cp-topbar-title">Civic Pulse</span>
            </div>
            <div class="cp-topbar-right">
                @if (IsAuthenticated)
                {
                    <NotificationBell UserId="@UserId" />
                }
                @if (IsAuthenticated)
                {
                    <div class="cp-flex cp-flex-center cp-gap-sm">
                        <span style="font-size:13px;">@FullName</span>
                        <button class="cp-btn cp-btn-ghost cp-btn-sm" @onclick="Logout">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </div>
                }
            </div>
        </header>

        <main class="cp-content cp-fade-in">
            @Body
        </main>
    </div>
</div>

<div class="cp-sidebar-overlay @(SidebarOpen ? "open" : "")" @onclick="ToggleSidebar"></div>

@code {
    private bool SidebarOpen;
    private bool IsAuthenticated;
    private bool IsAdmin;
    private string FullName = "";
    private int UserId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        IsAuthenticated = user.Identity?.IsAuthenticated ?? false;

        if (IsAuthenticated)
        {
            IsAdmin = user.HasClaim("role", "Admin");
            FullName = user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "";
            var userIdClaim = user.FindFirst("userId")?.Value;
            UserId = userIdClaim != null ? int.Parse(userIdClaim) : 0;
        }
    }

    private void ToggleSidebar() => SidebarOpen = !SidebarOpen;

    private void Logout()
    {
        Navigation.NavigateTo("/api/auth/logout", true);
    }
}
