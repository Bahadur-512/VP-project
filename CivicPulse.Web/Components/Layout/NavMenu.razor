@inject LocalizationService Loc
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<div class="cp-sidebar-nav">
    @if (IsAdmin)
    {
        <NavLink class="cp-nav-item" href="/admin/dashboard" Match="NavLinkMatch.All">
            <i class="bi bi-speedometer2"></i> <span>@Loc.Get("nav.admin.dashboard", Language)</span>
        </NavLink>
        <NavLink class="cp-nav-item" href="/admin/complaints" Match="NavLinkMatch.All">
            <i class="bi bi-list-task"></i> <span>@Loc.Get("nav.admin.complaints", Language)</span>
        </NavLink>
        <NavLink class="cp-nav-item" href="/admin/sla" Match="NavLinkMatch.All">
            <i class="bi bi-clock"></i> <span>@Loc.Get("nav.admin.sla", Language)</span>
        </NavLink>
        <NavLink class="cp-nav-item" href="/admin/users" Match="NavLinkMatch.All">
            <i class="bi bi-people"></i> <span>@Loc.Get("nav.admin.users", Language)</span>
        </NavLink>
        <NavLink class="cp-nav-item" href="/admin/categories" Match="NavLinkMatch.All">
            <i class="bi bi-tags"></i> <span>@Loc.Get("nav.admin.categories", Language)</span>
        </NavLink>
        <NavLink class="cp-nav-item" href="/admin/feedback" Match="NavLinkMatch.All">
            <i class="bi bi-chat-square-text"></i> <span>Feedback</span>
        </NavLink>
        <NavLink class="cp-nav-item" href="/admin/audit" Match="NavLinkMatch.All">
            <i class="bi bi-journal-text"></i> <span>@Loc.Get("nav.admin.audit", Language)</span>
        </NavLink>
        <hr style="border-color: rgba(255,255,255,.1); margin: 8px 16px;" />
    }
    @if (IsAuthenticated)
    {
        <NavLink class="cp-nav-item" href="/citizen/dashboard" Match="NavLinkMatch.All">
            <i class="bi bi-house"></i> <span>@Loc.Get("nav.dashboard", Language)</span>
        </NavLink>
        <NavLink class="cp-nav-item" href="/citizen/submit" Match="NavLinkMatch.All">
            <i class="bi bi-plus-circle"></i> <span>@Loc.Get("nav.submit", Language)</span>
        </NavLink>
        <NavLink class="cp-nav-item" href="/citizen/complaints" Match="NavLinkMatch.All">
            <i class="bi bi-file-text"></i> <span>@Loc.Get("nav.my.complaints", Language)</span>
        </NavLink>
        <NavLink class="cp-nav-item" href="/citizen/notifications" Match="NavLinkMatch.All">
            <i class="bi bi-bell"></i> <span>@Loc.Get("nav.notifications", Language)</span>
        </NavLink>
    }
    else
    {
        <NavLink class="cp-nav-item" href="/login" Match="NavLinkMatch.All">
            <i class="bi bi-box-arrow-in-right"></i> <span>@Loc.Get("nav.login", Language)</span>
        </NavLink>
        <NavLink class="cp-nav-item" href="/register" Match="NavLinkMatch.All">
            <i class="bi bi-person-plus"></i> <span>@Loc.Get("nav.register", Language)</span>
        </NavLink>
    }
</div>

@code {
    [Parameter] public bool IsAuthenticated { get; set; }
    [Parameter] public bool IsAdmin { get; set; }
    [Parameter] public string Language { get; set; } = "en";

    protected override async Task OnInitializedAsync()
    {
        await Loc.InitializeAsync();
    }
}
